{
 "dataset": "nfl_origination_lab_price_policy",
 "title": "Price-data policy, decided before any staking number is published",
 "built": "2026-11-19",
 "decision": {
  "rule": "a price row may carry an ROI only if its publisher is official AND its capture time is known",
  "claimable_open_rows": 0,
  "claimable_close_rows": 0,
  "verdict": "the intersection is empty. No officially published number in the store has a known capture time, and no number with a known capture time is officially published.",
  "therefore": [
   "no ROI, CLV, units or bankroll is published in this namespace",
   "no -110, no assumed vig, no assumed push or void rule",
   "proper scores (Brier, CRPS) are unaffected and are published",
   "an ORIGINATION residual against the official posted line is published and labelled 'market divergence', never 'CLV'"
  ],
  "what_would_unblock_staking": [
   "a licensed feed or an operator's own price history with capture timestamps",
   "or an official league/club page that publishes a dated closing number",
   "and, separately, the operator's own void/push rules for combos"
  ]
 },
 "classification_rule": {
  "C1": "a line is present for the named market",
  "C2": "a source key is recorded for that line",
  "C3": "the source key appears in source_register",
  "C4": "the register records the key as an official nfl.com publication, and records a known capture time for it",
  "claimable_requires": "C1 and C2 and C3 and C4"
 },
